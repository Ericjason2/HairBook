<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Card Styles -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Linen}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="BackgroundColor" Value="{StaticResource Cream}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="DarkCardBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="AccentBadgeBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SearchBoxBorder" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Transparent}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="BackgroundColor" Value="{StaticResource Cream}" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Button Styles -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="SoftBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="OutlineBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="BorderColor" Value="{StaticResource Linen}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="OutlineButtonStyle" BasedOn="{StaticResource OutlineBtn}" TargetType="Button" />
    <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource PrimaryBtn}" TargetType="Button" />
    <Style x:Key="SoftButtonStyle" BasedOn="{StaticResource SoftBtn}" TargetType="Button" />

    <!-- Typography Styles -->
    <Style x:Key="DisplayTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="DMSerifDisplay" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="BodyMuted" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="CaptionSubtle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Subtle}" />
    </Style>

    <!-- Lucide Icon Styles -->
    <Style x:Key="LucideIcon" TargetType="Label">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="LucideIconBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
