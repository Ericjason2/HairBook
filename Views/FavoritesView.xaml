<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.FavoritesView"
             x:DataType="vm:FavoritesViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0">
        <!-- Header & Tabs -->
        <VerticalStackLayout Grid.Row="0" Spacing="16" Margin="0,0,0,16">
            <Label Text="Mes favoris" Style="{StaticResource DisplayTitle}" FontSize="30" />

            <Border Stroke="{StaticResource Linen}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource Cream}"
                    Padding="4">
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Text="{Binding FavoriteStyles.Count, StringFormat='Styles ({0})'}" Command="{Binding SetTabCommand}" CommandParameter="styles"
                            BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}"
                            HeightRequest="40" CornerRadius="12" FontFamily="OpenSansSemibold" FontSize="13">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="styles">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1" Text="{Binding FavoriteBarbers.Count, StringFormat='Barbers ({0})'}" Command="{Binding SetTabCommand}" CommandParameter="barbers"
                            BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}"
                            HeightRequest="40" CornerRadius="12" FontFamily="OpenSansSemibold" FontSize="13">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="barbers">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Content Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,32">
                <!-- TAB 1: Favorite Styles -->
                <VerticalStackLayout Spacing="12" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="styles">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- Empty State -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="False" Padding="24" Margin="0,16,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding FavoriteStyles.Count}" Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="&#xe0f2;" FontFamily="Lucide" FontSize="36" TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                            <Label Text="Aucun style favori" Style="{StaticResource DisplayTitle}" FontSize="22" HorizontalTextAlignment="Center" />
                            <Label Text="Ajoutez des coupes qui vous inspirent en touchant le cœur." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                            <Button Text="Explorer les styles" Command="{Binding ExploreStylesCommand}" Style="{StaticResource SoftBtn}" HorizontalOptions="Center" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Styles Grid -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding FavoriteStyles}"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HairStyle">
                                <VerticalStackLayout Spacing="6" WidthRequest="165" Margin="0,0,0,16">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 24"
                                            BackgroundColor="{StaticResource Sand}"
                                            HeightRequest="210"
                                            WidthRequest="165">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=SelectStyleCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <Image Source="{Binding Image}" Aspect="AspectFill" />

                                            <!-- Heart Remove Button -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 16"
                                                    BackgroundColor="#B3FFFFFF"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=ToggleFavoriteStyleCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe0f2;" FontFamily="Lucide" TextColor="#DC2626" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                                    <Label Text="{Binding BarberName}" FontSize="12" TextColor="{StaticResource Muted}" />
                                    <Label Text="{Binding StartingPriceFormatted}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- TAB 2: Favorite Barbers -->
                <VerticalStackLayout Spacing="12" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="barbers">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- Empty State -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="False" Padding="24" Margin="0,16,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding FavoriteBarbers.Count}" Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="&#xe0f2;" FontFamily="Lucide" FontSize="36" TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                            <Label Text="Aucun barber favori" Style="{StaticResource DisplayTitle}" FontSize="22" HorizontalTextAlignment="Center" />
                            <Label Text="Gardez vos barbiers préférés à portée de main." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                            <Button Text="Trouver un barber" Command="{Binding ExploreStylesCommand}" Style="{StaticResource SoftBtn}" HorizontalOptions="Center" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Barbers Rows in Cream Card -->
                    <Border Style="{StaticResource CardBorder}" Padding="8">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavoriteBarbers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Barber">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=SelectBarberCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18"
                                                    WidthRequest="56"
                                                    HeightRequest="56">
                                                <Image Source="{Binding Avatar}" Aspect="AspectFill" />
                                            </Border>

                                            <!-- Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                                    <Label Text="&#xe06c;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Specialty}" FontSize="13" TextColor="{StaticResource Muted}" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="&#xe111;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                                    <Label Text="{Binding ShortLocation}" FontSize="12" TextColor="{StaticResource Muted}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Heart Remove Button -->
                                            <Border Grid.Column="2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18"
                                                    BackgroundColor="{StaticResource Bone}"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    VerticalOptions="Center">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=ToggleFavoriteBarberCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe0f2;" FontFamily="Lucide" TextColor="#DC2626" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
