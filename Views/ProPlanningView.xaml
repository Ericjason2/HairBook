<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.ProPlanningView"
             x:DataType="vm:ProPlanningViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="20,16,20,0">
            <!-- Header: Title, Settings button, Segmented Tabs -->
            <VerticalStackLayout Grid.Row="0" Spacing="16" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Planning" Style="{StaticResource DisplayTitle}" FontSize="30" />
                    <Button Grid.Column="1"
                            Text="&#xe154;"
                            FontFamily="Lucide"
                            Command="{Binding OpenHoursCommand}"
                            BackgroundColor="{StaticResource Cream}"
                            TextColor="{StaticResource Ink}"
                            FontSize="18"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0" />
                </Grid>

                <!-- Segmented Tabs: Jour | Semaine | Historique -->
                <Border Stroke="{StaticResource Linen}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource Cream}"
                        Padding="4">
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Text="Jour" Command="{Binding SetViewCommand}" CommandParameter="day"
                                BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}"
                                HeightRequest="40" CornerRadius="12" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveView}" Value="day">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource Ink}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Grid.Column="1" Text="Semaine" Command="{Binding SetViewCommand}" CommandParameter="week"
                                BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}"
                                HeightRequest="40" CornerRadius="12" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveView}" Value="week">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource Ink}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Grid.Column="2" Text="Historique" Command="{Binding SetViewCommand}" CommandParameter="history"
                                BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}"
                                HeightRequest="40" CornerRadius="12" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveView}" Value="history">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="TextColor" Value="{StaticResource Ink}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <!-- Day Selector Carousel (Only when in 'day' view) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="False">
                    <ScrollView.Triggers>
                        <DataTrigger TargetType="ScrollView" Binding="{Binding ActiveView}" Value="day">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </ScrollView.Triggers>
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding PlanningWeek}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PlanningDay">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="54"
                                        HeightRequest="68"
                                        Padding="4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProPlanningViewModel}}, Path=SelectDayCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Id}" Value="{Binding Source={RelativeSource AncestorType={x:Type vm:ProPlanningViewModel}}, Path=SelectedDay.Id}">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Label Text="{Binding ShortName}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Date}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 2" BackgroundColor="{StaticResource Ink}" WidthRequest="4" HeightRequest="4" HorizontalOptions="Center" IsVisible="{Binding Slots.Count, Converter={StaticResource StringNotEmptyConverter}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Scrollable Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,32">
                    <!-- VIEW 1: Day Timeline -->
                    <VerticalStackLayout Spacing="12" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveView}" Value="day">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- Closed State -->
                        <Border Style="{StaticResource CardBorder}" Padding="24" IsVisible="{Binding SelectedDay.Closed}">
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Label Text="&#xe063;" FontFamily="Lucide" FontSize="36" TextColor="{StaticResource Muted}" HorizontalOptions="Center" />
                                <Label Text="Salon fermé" Style="{StaticResource DisplayTitle}" FontSize="22" HorizontalTextAlignment="Center" />
                                <Label Text="Vous ne recevez pas de clients ce jour-là." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                                <Button Text="Modifier mes horaires" Command="{Binding OpenHoursCommand}" Style="{StaticResource SoftBtn}" HorizontalOptions="Center" Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Open Day Header -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SelectedDay.Closed, Converter={StaticResource InverseBoolConverter}}">
                            <Label Grid.Column="0" Text="{Binding SelectedDay.Label}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding SelectedDay.FreeMinutesFormatted}" Style="{StaticResource CaptionSubtle}" />
                        </Grid>

                        <!-- Slots Timeline -->
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding SelectedDay.Slots}"
                                             IsVisible="{Binding SelectedDay.Closed, Converter={StaticResource InverseBoolConverter}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PlanningSlot">
                                    <Border Style="{StaticResource CardBorder}" Padding="16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProPlanningViewModel}}, Path=SelectSlotCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <!-- Time Block -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="60">
                                                <Label Text="{Binding Start}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding EndTime}" Style="{StaticResource CaptionSubtle}" />
                                            </VerticalStackLayout>

                                            <!-- Client & Service -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Client}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding Service}" FontSize="13" TextColor="{StaticResource Muted}" />
                                            </VerticalStackLayout>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToBgColorConverter}}"
                                                    Padding="10,4"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                                       TextColor="{Binding Status, Converter={StaticResource StatusToTextColorConverter}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- VIEW 2: Semaine Overview -->
                    <VerticalStackLayout Spacing="10" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveView}" Value="week">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding PlanningWeek}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PlanningDay">
                                    <Border Style="{StaticResource CardBorder}" Padding="16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProPlanningViewModel}}, Path=SelectDayCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                            <!-- Date Column -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="44">
                                                <Label Text="{Binding ShortName}" Style="{StaticResource CaptionSubtle}" />
                                                <Label Text="{Binding Date}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" />
                                            </VerticalStackLayout>

                                            <!-- Progress Bar or Closed -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Label Text="Fermé" Style="{StaticResource CaptionSubtle}" IsVisible="{Binding Closed}" />
                                                <VerticalStackLayout Spacing="4" IsVisible="{Binding Closed, Converter={StaticResource InverseBoolConverter}}">
                                                    <!-- Custom Progress Bar -->
                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Bone}" HeightRequest="8">
                                                        <BoxView HorizontalOptions="Start" WidthRequest="{Binding OccupancyPercentage, StringFormat='{0}*2'}" Color="{StaticResource Ink}" HeightRequest="8" />
                                                    </Border>
                                                    <Label Text="{Binding Slots.Count, StringFormat='{0} rdv'}" Style="{StaticResource CaptionSubtle}" />
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2" Text="{Binding OccupancyPercentage, StringFormat='{0}%'}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" VerticalOptions="Center" IsVisible="{Binding Closed, Converter={StaticResource InverseBoolConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- VIEW 3: Historique -->
                    <VerticalStackLayout Spacing="10" IsVisible="False">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveView}" Value="history">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Border Style="{StaticResource CardBorder}" Padding="8">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProHistory}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryEntry">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,14">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Client}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                                    <Label Text="{Binding Service, StringFormat='{0} · {1}', Source={Binding DateLabel}}" FontSize="13" TextColor="{StaticResource Muted}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                                    <Label Text="{Binding FormattedPrice}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" HorizontalTextAlignment="End" />
                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{Binding Status, Converter={StaticResource StatusToBgColorConverter}}" Padding="8,2">
                                                        <Label Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" TextColor="{Binding Status, Converter={StaticResource StatusToTextColorConverter}}" FontSize="11" FontFamily="OpenSansSemibold" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Slot Detail Modal Sheet -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsSlotDetailOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="400"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Rendez-vous" Style="{StaticResource DisplayTitle}" FontSize="24" />
                        <Button Grid.Column="1" Text="&#xe1b2;" FontFamily="Lucide" Command="{Binding CloseSlotDetailCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Ink}" FontSize="18" Padding="0" />
                    </Grid>

                    <Label Text="{Binding SelectedSlot.Client}" Style="{StaticResource DisplayTitle}" FontSize="24" />
                    <Label Text="{Binding SelectedSlot.Service, StringFormat='{0} · {1}', Source={Binding SelectedSlot.Start}}" Style="{StaticResource BodyMuted}" />

                    <!-- Status -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding SelectedSlot.Status, Converter={StaticResource StatusToBgColorConverter}}" Padding="12,4" HorizontalOptions="Start">
                        <Label Text="{Binding SelectedSlot.Status, Converter={StaticResource StatusToTextConverter}}" TextColor="{Binding SelectedSlot.Status, Converter={StaticResource StatusToTextColorConverter}}" FontFamily="OpenSansSemibold" FontSize="12" />
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                        <Button Grid.Column="0" Text="Refuser" Command="{Binding DeclineSlotCommand}" Style="{StaticResource OutlineBtn}" />
                        <Button Grid.Column="1" Text="Accepter" Command="{Binding AcceptSlotCommand}" Style="{StaticResource PrimaryBtn}" HeightRequest="46" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
