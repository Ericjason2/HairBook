<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="20,16,20,12">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="&#xe048;"
                        FontFamily="Lucide"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{StaticResource Transparent}"
                        TextColor="{StaticResource Ink}"
                        FontSize="18"
                        HorizontalOptions="Start"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36" />
                <Label Grid.Column="1"
                       Text="Notifications"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center"
                       Margin="-36,0,0,0"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Unread Status + Mark All Read -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding UnreadCount, StringFormat='{0} non lues'}"
                       Style="{StaticResource CaptionSubtle}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="Tout marquer comme lu"
                        Command="{Binding MarkAllAsReadCommand}"
                        BackgroundColor="{StaticResource Transparent}"
                        TextColor="{StaticResource Ink}"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Padding="0" />
            </Grid>
        </VerticalStackLayout>

        <!-- Notifications List -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,0,20,32">
                <Border Style="{StaticResource CardBorder}" Padding="8">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notifications}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AppNotification">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="12,14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenNotificationCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <!-- Notification Icon in Circle -->
                                        <Border Grid.Column="0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 22"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                VerticalOptions="Start">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Read}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Read}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Bone}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="&#xe059;" FontFamily="Lucide" FontSize="18" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Notification Content -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                                                <Label Grid.Column="1" Text="{Binding Time}" Style="{StaticResource CaptionSubtle}" />
                                            </Grid>

                                            <Label Text="{Binding Body}" FontSize="13" TextColor="{StaticResource Muted}" LineHeight="1.2" />
                                        </VerticalStackLayout>

                                        <!-- Unread Dot -->
                                        <Border Grid.Column="2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{StaticResource Ink}"
                                                WidthRequest="8"
                                                HeightRequest="8"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding Read, Converter={StaticResource InverseBoolConverter}}" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
