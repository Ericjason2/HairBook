<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="{StaticResource Bone}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="20,16,20,32">
            <!-- Header: Greeting + Notification Bell -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Bonjour, Eric"
                           Style="{StaticResource DisplayTitle}"
                           FontSize="30" />
                    <Label Text="Quel style recherchez-vous aujourd’hui ?"
                           Style="{StaticResource BodyMuted}"
                           FontSize="15" />
                </VerticalStackLayout>

                <!-- Notification Bell Button -->
                <Border Grid.Column="1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="{StaticResource Cream}"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="&#xe059;"
                               FontFamily="Lucide"
                               FontSize="18"
                               TextColor="{StaticResource Ink}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <!-- Red Dot -->
                        <Border Stroke="{StaticResource Cream}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 5"
                                BackgroundColor="{StaticResource Ink}"
                                WidthRequest="10"
                                HeightRequest="10"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,8,8,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Search Bar (Clicking switches to Explore) -->
            <Border Style="{StaticResource SearchBoxBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenExploreCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="&#xe151;" FontFamily="Lucide" FontSize="16" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Rechercher une coupe, un barber..."
                           Style="{StaticResource BodyMuted}"
                           FontSize="15"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Next Appointment Card (Dark Charcoal) -->
            <Border Style="{StaticResource DarkCardBorder}"
                    IsVisible="{Binding NextAppointment, Converter={StaticResource StringNotEmptyConverter}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenNextAppointmentCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="14">
                    <!-- Header: Label + Status Pill -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Prochain rendez-vous"
                               TextColor="#B3F5EBE0"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{Binding NextAppointment.Status, Converter={StaticResource StatusToBgColorConverter}}"
                                Padding="10,4">
                            <Label Text="{Binding NextAppointment.Status, Converter={StaticResource StatusToTextConverter}}"
                                   TextColor="{Binding NextAppointment.Status, Converter={StaticResource StatusToTextColorConverter}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12" />
                        </Border>
                    </Grid>

                    <!-- Middle: Avatar + Title + Barber + Chevron -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="50"
                                HeightRequest="50">
                            <Image Source="{Binding NextAppointment.BarberAvatar}" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding NextAppointment.ServiceName}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="{StaticResource Cream}" />
                            <Label Text="{Binding NextAppointment.BarberName}"
                                   FontSize="13"
                                   TextColor="#B3F5EBE0" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="&#xe06f;"
                               FontFamily="Lucide"
                               FontSize="18"
                               TextColor="#B3F5EBE0"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Bottom: Date & Time Badges -->
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#26F5EBE0"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="&#xe063;" FontFamily="Lucide" FontSize="13" TextColor="{StaticResource Cream}" VerticalOptions="Center" />
                                <Label Text="{Binding NextAppointment.DateLabel}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="{StaticResource Cream}" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#26F5EBE0"
                                Padding="12,6">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="&#xe087;" FontFamily="Lucide" FontSize="13" TextColor="{StaticResource Cream}" VerticalOptions="Center" />
                                <Label Text="{Binding NextAppointment.Time}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="{StaticResource Cream}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Categories Horizontal List -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Catégories" Style="{StaticResource SectionTitle}" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="16"
                                           BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StyleCategoryItem">
                                <VerticalStackLayout Spacing="6" WidthRequest="64">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenExploreCommand}"
                                                              CommandParameter="{Binding Id}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Border Stroke="{StaticResource Sand}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 32"
                                            WidthRequest="64"
                                            HeightRequest="64">
                                        <Image Source="{Binding Image}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Text="{Binding Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="{StaticResource Ink}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Popular Styles Horizontal Carousel -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Styles populaires" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Text="Voir tout"
                            Command="{Binding OpenExploreCommand}"
                            BackgroundColor="{StaticResource Transparent}"
                            TextColor="{StaticResource Muted}"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            Padding="0" />
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="14"
                                           BindableLayout.ItemsSource="{Binding PopularStyles}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HairStyle">
                                <VerticalStackLayout Spacing="6" WidthRequest="200">
                                    <!-- Image Card with Heart Button -->
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 24"
                                            BackgroundColor="{StaticResource Sand}"
                                            HeightRequest="240"
                                            WidthRequest="200">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectStyleCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid>
                                            <Image Source="{Binding Image}" Aspect="AspectFill" />

                                            <!-- Heart Favorite Button -->
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18"
                                                    BackgroundColor="#B3FFFFFF"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ToggleFavoriteCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="&#xe0f2;"
                                                       FontFamily="Lucide"
                                                       TextColor="{Binding IsFavorite, Converter={StaticResource BoolToHeartColorConverter}}"
                                                       FontSize="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Details -->
                                    <VerticalStackLayout Spacing="2" Padding="4,0">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="{StaticResource Ink}" />
                                        <Label Text="{Binding BarberName}"
                                               FontSize="13"
                                               TextColor="{StaticResource Muted}" />
                                        <Label Text="{Binding StartingPriceFormatted}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Popular Barbers List -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Barbers populaires" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1"
                            Text="Voir tout"
                            Command="{Binding OpenExploreCommand}"
                            CommandParameter="Barbers"
                            BackgroundColor="{StaticResource Transparent}"
                            TextColor="{StaticResource Muted}"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            Padding="0" />
                </Grid>

                <Border Style="{StaticResource CardBorder}" Padding="8">
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding PopularBarbers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Barber">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectBarberCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18"
                                                WidthRequest="60"
                                                HeightRequest="60">
                                            <Image Source="{Binding Avatar}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="15"
                                                       TextColor="{StaticResource Ink}" />
                                                <Label Text="&#xe06c;"
                                                       FontFamily="Lucide"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Ink}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Specialty}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Muted}" />

                                            <HorizontalStackLayout Spacing="8">
                                                <HorizontalStackLayout Spacing="3">
                                                    <Label Text="&#xe176;" FontFamily="Lucide" TextColor="{StaticResource Ink}" FontSize="12" VerticalOptions="Center" />
                                                    <Label Text="{Binding RatingFormatted}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Ink}" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="3">
                                                    <Label Text="&#xe111;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                                    <Label Text="{Binding ShortLocation}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Muted}" />
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Button -->
                                        <Button Grid.Column="2"
                                                Text="Voir profil"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectBarberCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SoftBtn}"
                                                HeightRequest="36"
                                                Padding="12,0"
                                                FontSize="12"
                                                VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
