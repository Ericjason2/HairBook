<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             x:Class="HairBook.Views.SplashView"
             BackgroundColor="{StaticResource Bone}">

    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
            <!-- Scissors Icon Emblem -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Accent}"
                    WidthRequest="96"
                    HeightRequest="96"
                    HorizontalOptions="Center">
                <Label Text="&#xe14e;"
                       FontFamily="Lucide"
                       FontSize="42"
                       TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Wordmark -->
            <Label Text="HairBook"
                   Style="{StaticResource DisplayTitle}"
                   FontSize="42"
                   HorizontalTextAlignment="Center" />

            <!-- Subtitle -->
            <Label Text="Votre style, votre rendez-vous."
                   Style="{StaticResource BodyMuted}"
                   FontSize="15"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Loading Dots -->
        <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,50" Spacing="8">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Ink}" WidthRequest="8" HeightRequest="8" />
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Ink}" WidthRequest="8" HeightRequest="8" Opacity="0.5" />
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="{StaticResource Ink}" WidthRequest="8" HeightRequest="8" Opacity="0.25" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
