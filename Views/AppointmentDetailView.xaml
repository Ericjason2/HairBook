<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             x:Class="HairBook.Views.AppointmentDetailView"
             x:DataType="vm:AppointmentDetailViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- App Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20,16">
                <Button Grid.Column="0"
                        Text="&#xe048;"
                        FontFamily="Lucide"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{StaticResource Transparent}"
                        TextColor="{StaticResource Ink}"
                        FontSize="18"
                        HorizontalOptions="Start"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36" />
                <Label Grid.Column="1"
                       Text="Détail du rendez-vous"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center"
                       Margin="-36,0,0,0"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Scrollable Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="20" Padding="20,10,20,24">
                    <!-- Barber Header -->
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="64" HeightRequest="64">
                                <Image Source="{Binding Appointment.BarberAvatar}" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Appointment.BarberName}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" />
                                <HorizontalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="&#xe176;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                        <Label Text="4.9" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Appointment.BarberSpecialty, StringFormat='· {0}'}" FontSize="13" TextColor="{StaticResource Muted}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Prestation Card -->
                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Prestation" Style="{StaticResource CaptionSubtle}" />
                                    <Label Text="{Binding Appointment.ServiceName}" Style="{StaticResource DisplayTitle}" FontSize="26" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{Binding Appointment.Status, Converter={StaticResource StatusToBgColorConverter}}"
                                        Padding="10,4"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding Appointment.Status, Converter={StaticResource StatusToTextConverter}}"
                                           TextColor="{Binding Appointment.Status, Converter={StaticResource StatusToTextColorConverter}}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12" />
                                </Border>
                            </Grid>

                            <!-- Date & Time Boxes -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Bone}" Padding="14,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Date" Style="{StaticResource CaptionSubtle}" />
                                        <Label Text="{Binding Appointment.DateLabel}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource Bone}" Padding="14,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Heure" Style="{StaticResource CaptionSubtle}" />
                                        <Label Text="{Binding Appointment.Time}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Duration & Price Details -->
                            <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Durée" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding Appointment.FormattedDuration}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Prix" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding Appointment.FormattedPrice}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Address Box -->
                    <Border Stroke="{StaticResource Linen}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#xe111;" FontFamily="Lucide" FontSize="18" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Adresse" Style="{StaticResource CaptionSubtle}" />
                                <Label Text="{Binding Appointment.BarberAddress}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Sticky Footer Actions -->
            <Border Grid.Row="2"
                    Stroke="{StaticResource Linen}"
                    StrokeThickness="1"
                    StrokeShape="Rectangle"
                    BackgroundColor="{StaticResource Bone}"
                    Padding="20,12,20,20">
                <VerticalStackLayout Spacing="10">
                    <!-- When Active (Confirmed/Pending) -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding Appointment.IsActive}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="Modifier"
                                    Command="{Binding ModifyAppointmentCommand}"
                                    Style="{StaticResource SoftBtn}"
                                    HeightRequest="46" />
                            <Button Grid.Column="1"
                                    Text="Contacter"
                                    Command="{Binding OpenContactCommand}"
                                    Style="{StaticResource OutlineBtn}" />
                        </Grid>

                        <Button Text="Annuler le rendez-vous"
                                Command="{Binding OpenCancelCommand}"
                                BackgroundColor="{StaticResource Transparent}"
                                TextColor="{StaticResource Ink}"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                HeightRequest="36" />
                    </VerticalStackLayout>

                    <!-- When Completed -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding Appointment.IsCompleted}">
                        <Button Text="Laisser un avis"
                                Command="{Binding OpenReviewCommand}"
                                Style="{StaticResource PrimaryBtn}" />
                        <Button Text="Réserver à nouveau"
                                Command="{Binding RebookCommand}"
                                Style="{StaticResource SoftBtn}"
                                HeightRequest="46" />
                    </VerticalStackLayout>

                    <!-- When Cancelled -->
                    <Button Text="Réserver à nouveau"
                            Command="{Binding RebookCommand}"
                            Style="{StaticResource PrimaryBtn}"
                            IsVisible="{Binding Appointment.IsCancelled}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Cancel Confirmation Modal -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsCancelModalOpen}"
              Padding="24"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="Center"
                    Padding="24"
                    MaximumWidthRequest="380">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Annuler le rendez-vous ?" Style="{StaticResource DisplayTitle}" FontSize="22" />
                    <Label Text="Cette action est irréversible. Le créneau sera à nouveau disponible pour d’autres clients." Style="{StaticResource BodyMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Non, garder" Command="{Binding CloseCancelCommand}" Style="{StaticResource SoftBtn}" />
                        <Button Grid.Column="1" Text="Oui, annuler" Command="{Binding ConfirmCancelCommand}" BackgroundColor="#B91C1C" TextColor="{StaticResource White}" CornerRadius="14" HeightRequest="40" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Contact Bottom Sheet -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsContactSheetOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="400"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Contacter le barber" Style="{StaticResource DisplayTitle}" FontSize="22" />
                        <Button Grid.Column="1" Text="&#xe1b2;" FontFamily="Lucide" Command="{Binding CloseContactCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Ink}" FontSize="18" Padding="0" />
                    </Grid>

                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallBarberCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xe133;" FontFamily="Lucide" FontSize="18" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Appeler" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                <Label Text="+225 07 00 11 22 33" Style="{StaticResource CaptionSubtle}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MessageBarberCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="&#xe117;" FontFamily="Lucide" FontSize="18" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Envoyer un message" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                <Label Text="Réponse moyenne en 15 min" Style="{StaticResource CaptionSubtle}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Review Bottom Sheet -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsReviewSheetOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="400"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Laisser un avis" Style="{StaticResource DisplayTitle}" FontSize="22" />
                        <Button Grid.Column="1" Text="&#xe1b2;" FontFamily="Lucide" Command="{Binding CloseReviewCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Ink}" FontSize="18" Padding="0" />
                    </Grid>

                    <Label Text="{Binding Appointment.ServiceName, StringFormat='Votre avis sur la prestation {0}'}" Style="{StaticResource BodyMuted}" />

                    <!-- Rating Stars -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8">
                        <Button Text="&#xe176;" FontFamily="Lucide" Command="{Binding SetRatingCommand}" CommandParameter="1" BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}" WidthRequest="44" HeightRequest="44" CornerRadius="12" FontSize="18" />
                        <Button Text="&#xe176;" FontFamily="Lucide" Command="{Binding SetRatingCommand}" CommandParameter="2" BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}" WidthRequest="44" HeightRequest="44" CornerRadius="12" FontSize="18" />
                        <Button Text="&#xe176;" FontFamily="Lucide" Command="{Binding SetRatingCommand}" CommandParameter="3" BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}" WidthRequest="44" HeightRequest="44" CornerRadius="12" FontSize="18" />
                        <Button Text="&#xe176;" FontFamily="Lucide" Command="{Binding SetRatingCommand}" CommandParameter="4" BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}" WidthRequest="44" HeightRequest="44" CornerRadius="12" FontSize="18" />
                        <Button Text="&#xe176;" FontFamily="Lucide" Command="{Binding SetRatingCommand}" CommandParameter="5" BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource Ink}" WidthRequest="44" HeightRequest="44" CornerRadius="12" FontSize="18" />
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <Editor Text="{Binding ReviewComment}" Placeholder="Racontez votre expérience..." HeightRequest="80" TextColor="{StaticResource Ink}" />
                    </Border>

                    <Button Text="Publier l’avis" Command="{Binding SubmitReviewCommand}" Style="{StaticResource PrimaryBtn}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
