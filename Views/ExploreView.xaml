<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.ExploreView"
             x:DataType="vm:ExploreViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="20,16,20,0">
            <!-- Header: Title, Search bar, Sliders button, Filter chips -->
            <VerticalStackLayout Grid.Row="0" Spacing="14" Margin="0,0,0,16">
                <Label Text="Explorer" Style="{StaticResource DisplayTitle}" FontSize="30" />

                <!-- Search Input + Filter Button -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="&#xe151;" FontFamily="Lucide" FontSize="16" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding SearchQuery}"
                                   Placeholder="Rechercher une coupe, un barber..."
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                   TextColor="{StaticResource Ink}"
                                   PlaceholderColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="&#xe1b2;"
                                    FontFamily="Lucide"
                                    Command="{Binding ClearFiltersCommand}"
                                    IsVisible="{Binding SearchQuery, Converter={StaticResource StringNotEmptyConverter}}"
                                    BackgroundColor="{StaticResource Linen}"
                                    TextColor="{StaticResource Ink}"
                                    CornerRadius="14"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Filter Sliders Button -->
                    <Border Grid.Column="1"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{StaticResource Accent}"
                            WidthRequest="52"
                            HeightRequest="52">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFilterSheetCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="&#xe162;" FontFamily="Lucide" FontSize="20" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Filter Chips (Tous, Coupes, Barbe, Coiffures, Barbers) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Tous" Command="{Binding SetFilterCommand}" CommandParameter="Tous"
                                BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}"
                                CornerRadius="18" HeightRequest="36" Padding="16,0" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Tous">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                    <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Coupes" Command="{Binding SetFilterCommand}" CommandParameter="Coupes"
                                BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}"
                                CornerRadius="18" HeightRequest="36" Padding="16,0" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Coupes">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                    <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Barbe" Command="{Binding SetFilterCommand}" CommandParameter="Barbe"
                                BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}"
                                CornerRadius="18" HeightRequest="36" Padding="16,0" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Barbe">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                    <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Coiffures" Command="{Binding SetFilterCommand}" CommandParameter="Coiffures"
                                BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}"
                                CornerRadius="18" HeightRequest="36" Padding="16,0" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Coiffures">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                    <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="Barbers" Command="{Binding SetFilterCommand}" CommandParameter="Barbers"
                                BackgroundColor="{StaticResource Cream}" TextColor="{StaticResource Ink}"
                                CornerRadius="18" HeightRequest="36" Padding="16,0" FontFamily="OpenSansSemibold" FontSize="13">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedFilter}" Value="Barbers">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                    <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Results Scrollable Area -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,32">
                    <!-- Results Count Label -->
                    <Label Text="{Binding ResultCount, StringFormat='{0} résultats'}"
                           Style="{StaticResource CaptionSubtle}"
                           FontSize="13" />

                    <!-- Empty State -->
                    <Border Stroke="{StaticResource Linen}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{StaticResource Cream}"
                            IsVisible="False"
                            Padding="24"
                            Margin="0,20,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ResultCount}" Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Label Text="&#xe151;" FontFamily="Lucide" FontSize="36" TextColor="{StaticResource Subtle}" HorizontalOptions="Center" />
                            <Label Text="Aucun résultat" Style="{StaticResource DisplayTitle}" FontSize="22" HorizontalTextAlignment="Center" />
                            <Label Text="Aucun style ni barber ne correspond à vos filtres actuels." Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
                            <Button Text="Effacer la recherche"
                                    Command="{Binding ClearFiltersCommand}"
                                    Style="{StaticResource SoftBtn}"
                                    HorizontalOptions="Center"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Styles Grid (when NOT Barbers) -->
                    <Grid IsVisible="{Binding ShowBarbers, Converter={StaticResource InverseBoolConverter}}">
                        <FlexLayout BindableLayout.ItemsSource="{Binding FilteredStyles}"
                                    Wrap="Wrap"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:HairStyle">
                                    <VerticalStackLayout Spacing="6" WidthRequest="165" Margin="0,0,0,16">
                                        <!-- Image Card with Heart -->
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 24"
                                                BackgroundColor="{StaticResource Sand}"
                                                HeightRequest="210"
                                                WidthRequest="165">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectStyleCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid>
                                                <Image Source="{Binding Image}" Aspect="AspectFill" />

                                                <!-- Favorite Button -->
                                                <Border StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 16"
                                                        BackgroundColor="#B3FFFFFF"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="8">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=ToggleFavoriteCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xe0f2;"
                                                           FontFamily="Lucide"
                                                           TextColor="{Binding IsFavorite, Converter={StaticResource BoolToHeartColorConverter}}"
                                                           FontSize="16"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                                        <Label Text="{Binding BarberName}" FontSize="12" TextColor="{StaticResource Muted}" />
                                        <Label Text="{Binding StartingPriceFormatted}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Grid>

                    <!-- Barbers List (when Barbers selected) -->
                    <Border Style="{StaticResource CardBorder}"
                            Padding="8"
                            IsVisible="{Binding ShowBarbers}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredBarbers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Barber">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="8,12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectBarberCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18"
                                                    WidthRequest="56"
                                                    HeightRequest="56">
                                                <Image Source="{Binding Avatar}" Aspect="AspectFill" />
                                            </Border>

                                            <!-- Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                                    <Label Text="&#xe06c;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Specialty}" FontSize="13" TextColor="{StaticResource Muted}" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="&#xe111;" FontFamily="Lucide" FontSize="12" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                                    <Label Text="{Binding ShortLocation}" FontSize="12" TextColor="{StaticResource Muted}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Button -->
                                            <Button Grid.Column="2"
                                                    Text="Voir profil"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=SelectBarberCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SoftBtn}"
                                                    HeightRequest="36"
                                                    Padding="12,0"
                                                    FontSize="12"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Linen}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Filter Bottom Sheet Modal Overlay -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsFilterSheetOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="420"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Filtrer" Style="{StaticResource DisplayTitle}" FontSize="24" />
                        <Button Grid.Column="1"
                                Text="&#xe1b2;"
                                FontFamily="Lucide"
                                Command="{Binding CloseFilterSheetCommand}"
                                BackgroundColor="{StaticResource Transparent}"
                                TextColor="{StaticResource Ink}"
                                FontSize="18"
                                Padding="0" />
                    </Grid>

                    <!-- Budget Filter -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Budget maximum" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Tous" Command="{Binding SetBudgetCommand}" CommandParameter="{x:Null}" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Button Text="≤ 2 500 F" Command="{Binding SetBudgetCommand}" CommandParameter="2500" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Button Text="≤ 3 500 F" Command="{Binding SetBudgetCommand}" CommandParameter="3500" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Button Text="≤ 5 000 F" Command="{Binding SetBudgetCommand}" CommandParameter="5000" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Sort -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Trier par" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Popularité" Command="{Binding SetSortCommand}" CommandParameter="popular" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                            <Button Text="Prix croissant" Command="{Binding SetSortCommand}" CommandParameter="price" CornerRadius="14" HeightRequest="36" Padding="12,0" FontFamily="OpenSansSemibold" FontSize="12" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                        <Button Grid.Column="0"
                                Text="Réinitialiser"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource OutlineBtn}" />
                        <Button Grid.Column="1"
                                Text="Appliquer"
                                Command="{Binding CloseFilterSheetCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                HeightRequest="46" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
