<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.ProDashboardView"
             x:DataType="vm:ProDashboardViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,16,20,32">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Bonjour Chris" Style="{StaticResource DisplayTitle}" FontSize="30" />
                        <Label Text="Lundi 7 octobre" Style="{StaticResource BodyMuted}" FontSize="15" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProAccountCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="{Binding CurrentPro.Avatar}" Aspect="AspectFill" />
                    </Border>
                </Grid>

                <!-- Big Dark Today Card -->
                <Border Style="{StaticResource DarkCardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Rendez-vous aujourd’hui" TextColor="#B3F5EBE0" FontFamily="OpenSansSemibold" FontSize="13" />

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding ActiveCount}" Style="{StaticResource DisplayTitle}" FontSize="56" TextColor="{StaticResource Cream}" />
                            <Label Text="{Binding PendingCount, StringFormat='dont {0} à confirmer'}"
                                   TextColor="#B3F5EBE0"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   Margin="0,0,0,10"
                                   IsVisible="{Binding PendingCount, Converter={StaticResource StringNotEmptyConverter}}" />
                        </HorizontalStackLayout>

                        <!-- Next Booking Banner -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#26F5EBE0"
                                Padding="16,12"
                                IsVisible="{Binding NextBooking, Converter={StaticResource StringNotEmptyConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPlanningCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding NextBooking.Time, StringFormat='Prochain · {0}'}" TextColor="#B3F5EBE0" FontSize="12" />
                                    <Label Text="{Binding NextBooking.Client, StringFormat='{0}'}" TextColor="{StaticResource Cream}" FontFamily="OpenSansSemibold" FontSize="15" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Accent}" WidthRequest="36" HeightRequest="36">
                                    <Label Text="&#xe06f;" FontFamily="Lucide" FontSize="16" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 3 Stats Cards -->
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="21" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                            <Label Text="Cette semaine" Style="{StaticResource CaptionSubtle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="0" HorizontalOptions="End" WidthRequest="1" Color="{StaticResource Linen}" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="1 240" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                            <Label Text="Clients" Style="{StaticResource CaptionSubtle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" HorizontalOptions="End" WidthRequest="1" Color="{StaticResource Linen}" />

                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                            <Label Text="86 500" FontFamily="OpenSansSemibold" FontSize="17" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                            <Label Text="Revenus (FCFA)" Style="{StaticResource CaptionSubtle}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Prochains rendez-vous Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Prochains rendez-vous" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Text="Planning" Command="{Binding OpenPlanningCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Muted}" FontFamily="OpenSansSemibold" FontSize="13" Padding="0" />
                    </Grid>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Bookings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProBooking">
                                <Border Style="{StaticResource CardBorder}" Padding="16">
                                    <VerticalStackLayout Spacing="12">
                                        <!-- Top Row: Time, Client, Status -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" WidthRequest="60">
                                                <Label Text="{Binding Time}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding FormattedDuration}" Style="{StaticResource CaptionSubtle}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Client}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding Service, StringFormat='{0}'}" FontSize="13" TextColor="{StaticResource Muted}" />
                                                <Label Text="{Binding FormattedPrice}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="{StaticResource Ink}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToBgColorConverter}}"
                                                    Padding="10,4"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                                       TextColor="{Binding Status, Converter={StaticResource StatusToTextColorConverter}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="12" />
                                            </Border>
                                        </Grid>

                                        <!-- Actions Row for Pending Bookings -->
                                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="8" IsVisible="{Binding IsPending}" Margin="0,4,0,0">
                                            <Button Grid.Column="0"
                                                    Text="Détails"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProDashboardViewModel}}, Path=ViewBookingDetailsCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource Transparent}"
                                                    TextColor="{StaticResource Ink}"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="13"
                                                    Padding="8,0" />

                                            <Button Grid.Column="1"
                                                    Text="Refuser"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProDashboardViewModel}}, Path=DeclineBookingCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource OutlineBtn}"
                                                    HeightRequest="38"
                                                    Padding="0" />

                                            <Button Grid.Column="2"
                                                    Text="Accepter"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProDashboardViewModel}}, Path=AcceptBookingCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource SoftBtn}"
                                                    HeightRequest="38"
                                                    Padding="0" />
                                        </Grid>

                                        <!-- Details action for accepted bookings -->
                                        <Button Text="Voir détails"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProDashboardViewModel}}, Path=ViewBookingDetailsCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding IsAccepted}"
                                                BackgroundColor="{StaticResource Transparent}"
                                                TextColor="{StaticResource Ink}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                HorizontalOptions="End"
                                                HeightRequest="32"
                                                Padding="0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Booking Details Sheet Modal -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsDetailSheetOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="400"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Détail de la réservation" Style="{StaticResource DisplayTitle}" FontSize="22" />
                        <Button Grid.Column="1" Text="&#xe1b2;" FontFamily="Lucide" Command="{Binding CloseDetailSheetCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Ink}" FontSize="18" Padding="0" />
                    </Grid>

                    <Label Text="{Binding SelectedBooking.Client}" Style="{StaticResource DisplayTitle}" FontSize="24" />

                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Prestation" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding SelectedBooking.Service}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Heure" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding SelectedBooking.Time}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Prix" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding SelectedBooking.FormattedPrice}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Téléphone" Style="{StaticResource BodyMuted}" />
                                <Label Grid.Column="1" Text="{Binding SelectedBooking.Phone}" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Appeler le client" Command="{Binding CallClientCommand}" Style="{StaticResource PrimaryBtn}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Decline Modal -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsDeclineModalOpen}"
              Padding="24"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="Center"
                    Padding="24"
                    MaximumWidthRequest="380">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Refuser la réservation ?" Style="{StaticResource DisplayTitle}" FontSize="22" />
                    <Label Text="Le client sera prévenu et le créneau redeviendra disponible." Style="{StaticResource BodyMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Retour" Command="{Binding CancelDeclineCommand}" Style="{StaticResource SoftBtn}" />
                        <Button Grid.Column="1" Text="Refuser" Command="{Binding ConfirmDeclineCommand}" BackgroundColor="#B91C1C" TextColor="{StaticResource White}" CornerRadius="14" HeightRequest="40" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
