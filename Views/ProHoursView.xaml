<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.ProHoursView"
             x:DataType="vm:ProHoursViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top App Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="20,16,20,12">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="&#xe048;"
                        FontFamily="Lucide"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{StaticResource Transparent}"
                        TextColor="{StaticResource Ink}"
                        FontSize="18"
                        HorizontalOptions="Start"
                        Padding="0"
                        WidthRequest="36"
                        HeightRequest="36" />
                <Label Grid.Column="1"
                       Text="Mes horaires"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{StaticResource Ink}"
                       HorizontalOptions="Center"
                       Margin="-36,0,0,0"
                       VerticalOptions="Center" />
            </Grid>
            <Label Text="Vos clients ne pourront réserver que pendant ces créneaux." Style="{StaticResource CaptionSubtle}" Margin="4,4,0,0" />
        </VerticalStackLayout>

        <!-- Weekly Schedule Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Schedule}" Padding="20,8,20,24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:DaySchedule">
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding Day}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding Enabled}" OnColor="{StaticResource Ink}" ThumbColor="{StaticResource Bone}" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="10" IsVisible="{Binding Enabled}">
                                    <BoxView HeightRequest="1" Color="{StaticResource Linen}" />

                                    <!-- Hours inputs -->
                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}" HeightRequest="44">
                                            <Entry Text="{Binding Open}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1" Text="—" TextColor="{StaticResource Muted}" VerticalOptions="Center" />

                                        <Border Grid.Column="2" Style="{StaticResource SearchBoxBorder}" HeightRequest="44">
                                            <Entry Text="{Binding Close}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Lunch Break Checkbox -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding HasBreak}" Color="{StaticResource Ink}" />
                                        <Label Grid.Column="1" Text="Pause déjeuner" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding HasBreak}" VerticalOptions="Center">
                                        <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}" HeightRequest="40">
                                            <Entry Text="{Binding BreakStart}" FontFamily="OpenSansSemibold" FontSize="13" HorizontalTextAlignment="Center" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1" Text="—" TextColor="{StaticResource Muted}" VerticalOptions="Center" />

                                        <Border Grid.Column="2" Style="{StaticResource SearchBoxBorder}" HeightRequest="40">
                                            <Entry Text="{Binding BreakEnd}" FontFamily="OpenSansSemibold" FontSize="13" HorizontalTextAlignment="Center" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Footer -->
        <Border Grid.Row="2"
                Stroke="{StaticResource Linen}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                BackgroundColor="{StaticResource Bone}"
                Padding="20,12,20,20">
            <Button Text="Enregistrer"
                    Command="{Binding SaveHoursCommand}"
                    Style="{StaticResource PrimaryBtn}" />
        </Border>
    </Grid>
</ContentView>
