<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HairBook.ViewModels"
             xmlns:models="clr-namespace:HairBook.Models"
             x:Class="HairBook.Views.ProServicesView"
             x:DataType="vm:ProServicesViewModel"
             BackgroundColor="{StaticResource Bone}">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,0">
            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <Label Text="Mes prestations" Style="{StaticResource DisplayTitle}" FontSize="30" />
                <Label Text="{Binding Services.Count, StringFormat='{0} prestations configurées'}" Style="{StaticResource BodyMuted}" FontSize="14" />
            </VerticalStackLayout>

            <!-- Services List -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Services}" Padding="0,0,0,24">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Service">
                            <Border Style="{StaticResource CardBorder}" Padding="16">
                                <VerticalStackLayout Spacing="14">
                                    <!-- Top Row: Name, Badge, Toggle -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                                                <Border Style="{StaticResource AccentBadgeBorder}" Padding="8,2">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Active}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Active}" Value="False">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Linen}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Active}" Value="True">
                                                                <Setter Property="Text" Value="Active" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Active}" Value="False">
                                                                <Setter Property="Text" Value="Masquée" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Description}" FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="2" />
                                        </VerticalStackLayout>

                                        <Switch Grid.Column="1"
                                                IsToggled="{Binding Active}"
                                                OnColor="{StaticResource Ink}"
                                                ThumbColor="{StaticResource Bone}"
                                                VerticalOptions="Start" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{StaticResource Linen}" />

                                    <!-- Bottom Row: Price & Actions -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="{Binding FormattedPrice, StringFormat='{0} · '}" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource Ink}" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding FormattedPrice}" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                                                    <Span Text=" · " TextColor="{StaticResource Muted}" />
                                                    <Span Text="{Binding FormattedDuration}" TextColor="{StaticResource Muted}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Button Grid.Column="1"
                                                Text="Modifier"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProServicesViewModel}}, Path=OpenEditServiceCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Transparent}"
                                                TextColor="{StaticResource Ink}"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                Padding="8,0"
                                                HeightRequest="36" />

                                        <Button Grid.Column="2"
                                                Text="Supprimer"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProServicesViewModel}}, Path=PromptDeleteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Transparent}"
                                                TextColor="#B91C1C"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                Padding="8,0"
                                                HeightRequest="36" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Bottom Button -->
            <Border Grid.Row="2"
                    Stroke="{StaticResource Linen}"
                    StrokeThickness="1"
                    StrokeShape="Rectangle"
                    BackgroundColor="{StaticResource Bone}"
                    Padding="0,12,0,20">
                <Button Text="Ajouter une prestation"
                        Command="{Binding OpenAddServiceCommand}"
                        Style="{StaticResource PrimaryBtn}" />
            </Border>
        </Grid>

        <!-- Add / Edit Service Form Sheet -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsFormSheetOpen}"
              Padding="16"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="End"
                    Padding="24"
                    MaximumWidthRequest="400"
                    HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Prestation" Style="{StaticResource DisplayTitle}" FontSize="22" />
                        <Button Grid.Column="1" Text="&#xe1b2;" FontFamily="Lucide" Command="{Binding CloseFormCommand}" BackgroundColor="{StaticResource Transparent}" TextColor="{StaticResource Ink}" FontSize="18" Padding="0" />
                    </Grid>

                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nom de la prestation" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                            <Border Style="{StaticResource SearchBoxBorder}">
                                <Entry Text="{Binding FormName}" Placeholder="ex: Dégradé américain" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Description" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Editor Text="{Binding FormDescription}" HeightRequest="60" TextColor="{StaticResource Ink}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Prix (FCFA)" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                                <Border Style="{StaticResource SearchBoxBorder}">
                                    <Entry Text="{Binding FormPrice}" Keyboard="Numeric" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Durée (min)" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource Ink}" />
                                <Border Style="{StaticResource SearchBoxBorder}">
                                    <Entry Text="{Binding FormDuration}" Keyboard="Numeric" TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Button Text="Enregistrer la prestation" Command="{Binding SaveServiceCommand}" Style="{StaticResource PrimaryBtn}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Delete Modal -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding IsDeleteModalOpen}"
              Padding="24"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="{StaticResource Bone}"
                    VerticalOptions="Center"
                    Padding="24"
                    MaximumWidthRequest="380">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Supprimer la prestation ?" Style="{StaticResource DisplayTitle}" FontSize="22" />
                    <Label Text="Cette prestation ne sera plus visible ni réservable par vos clients." Style="{StaticResource BodyMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Annuler" Command="{Binding CancelDeleteCommand}" Style="{StaticResource SoftBtn}" />
                        <Button Grid.Column="1" Text="Supprimer" Command="{Binding ConfirmDeleteCommand}" BackgroundColor="#B91C1C" TextColor="{StaticResource White}" CornerRadius="14" HeightRequest="40" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
