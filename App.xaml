<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:HairBook.Converters"
             xmlns:local="clr-namespace:HairBook"
             x:Class="HairBook.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/HairBookStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:StatusToBgColorConverter x:Key="StatusToBgColorConverter" />
            <converters:StatusToTextColorConverter x:Key="StatusToTextColorConverter" />
            <converters:StatusToTextConverter x:Key="StatusToTextConverter" />
            <converters:BoolToHeartColorConverter x:Key="BoolToHeartColorConverter" />
            <converters:BoolToHeartGlyphConverter x:Key="BoolToHeartGlyphConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:StringEqualsToColorConverter x:Key="StringEqualsToColorConverter" />
            <converters:StringEqualsToPillBgConverter x:Key="StringEqualsToPillBgConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
